rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function channelMember(channelId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.memberIds;
    }

    function channelMemberAfter(channelId) {
      return signedIn()
        && request.auth.uid in getAfter(/databases/$(database)/documents/channels/$(channelId)).data.memberIds;
    }

    function validChannel() {
      return request.resource.data.keys().hasOnly([
          'name',
          'normalizedName',
          'nameKey',
          'description',
          'creatorId',
          'memberIds',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.normalizedName is string
        && request.resource.data.nameKey is string
        && request.resource.data.description is string
        && request.resource.data.creatorId is string
        && request.resource.data.memberIds is list;
    }

    function validChannelName(nameKey) {
      let channelId = request.resource.data.channelId;
      let channel = getAfter(/databases/$(database)/documents/channels/$(channelId));
      return request.resource.data.keys().hasOnly(['channelId', 'normalizedName'])
        && channelId is string
        && request.resource.data.normalizedName is string
        && channel.data.nameKey == nameKey
        && channel.data.normalizedName == request.resource.data.normalizedName
        && request.auth.uid in channel.data.memberIds;
    }

    function directMessageMember(dmId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)).data.participantIds;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /channelNames/{nameKey} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && validChannelName(nameKey);
      allow update: if false;
      allow delete: if signedIn() && channelMemberAfter(resource.data.channelId);
    }

    match /channels/{channelId} {
      allow read: if channelMember(channelId);
      allow create: if signedIn()
        && validChannel()
        && request.auth.uid == request.resource.data.creatorId
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if channelMember(channelId)
        && validChannel()
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /messages/{messageId} {
        allow read, create, update, delete: if channelMember(channelId);

        match /replies/{replyId} {
          allow read, create, update, delete: if channelMember(channelId);
        }
      }
    }

    match /directMessages/{dmId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update, delete: if directMessageMember(dmId);

      match /messages/{messageId} {
        allow read, create, update, delete: if directMessageMember(dmId);

        match /replies/{replyId} {
          allow read, create, update, delete: if directMessageMember(dmId);
        }
      }
    }
  }
}
