rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function channelMember(channelId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.memberIds;
    }

    function directMessageMember(dmId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)).data.participantIds;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /channels/{channelId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.creatorId
        && request.auth.uid in request.resource.data.memberIds;
      allow update, delete: if channelMember(channelId);

      match /messages/{messageId} {
        allow read, create, update, delete: if channelMember(channelId);

        match /replies/{replyId} {
          allow read, create, update, delete: if channelMember(channelId);
        }
      }
    }

    match /directMessages/{dmId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update, delete: if directMessageMember(dmId);

      match /messages/{messageId} {
        allow read, create, update, delete: if directMessageMember(dmId);

        match /replies/{replyId} {
          allow read, create, update, delete: if directMessageMember(dmId);
        }
      }
    }
  }
}
