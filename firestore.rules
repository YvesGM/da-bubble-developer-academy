rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function anonymousUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Only channels created by guests can be managed by another anonymous session.
    function guestChannelEditor(data) {
      return anonymousUser()
        && data.guestAccess == true
        && (request.auth.uid == data.creatorId
          || data.get('creatorIsGuest', false) == true);
    }

    function channelAccessData(data) {
      return signedIn()
        && (request.auth.uid in data.memberIds
          || (anonymousUser() && data.guestAccess == true)
          || (!anonymousUser() && data.get('autoJoin', false) == true));
    }

    function channelAccess(channelId) {
      return channelAccessData(
        get(/databases/$(database)/documents/channels/$(channelId)).data
      );
    }

    function registeredChannelMember(channelId) {
      return signedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/channels/$(channelId)
        ).data.memberIds;
    }

    function registeredChannelMemberAfter(channelId) {
      return signedIn()
        && request.auth.uid in getAfter(
          /databases/$(database)/documents/channels/$(channelId)
        ).data.memberIds;
    }

    function validChannel() {
      return request.resource.data.keys().hasOnly([
          'name', 'normalizedName', 'nameKey', 'description', 'creatorId',
          'creatorIsGuest', 'memberIds', 'guestAccess', 'autoJoin',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.normalizedName is string
        && request.resource.data.nameKey is string
        && request.resource.data.description is string
        && request.resource.data.creatorId is string
        && request.resource.data.get('creatorIsGuest', false) is bool
        && request.resource.data.memberIds is list
        && request.resource.data.guestAccess is bool
        && request.resource.data.get('autoJoin', false) is bool
        && (!request.resource.data.get('autoJoin', false)
          || (request.resource.data.guestAccess == true && !anonymousUser()));
    }

    function validChannelName(nameKey) {
      let channelId = request.resource.data.channelId;
      let channel = getAfter(/databases/$(database)/documents/channels/$(channelId));
      return request.resource.data.keys().hasOnly(['channelId', 'normalizedName'])
        && channelId is string
        && request.resource.data.normalizedName is string
        && channel.data.nameKey == nameKey
        && channel.data.normalizedName == request.resource.data.normalizedName
        && channelAccessData(channel.data);
    }

    function directMessageAccess(dmId) {
      return signedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/directMessages/$(dmId)
        ).data.participantIds;
    }

    // A user may check their own not-yet-created notes conversation.
    function selfDirectMessage(dmId) {
      return signedIn()
        && dmId == request.auth.uid + '__' + request.auth.uid;
    }

    function validDirectMessage() {
      return request.resource.data.keys().hasOnly([
          'participantIds', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() >= 1
        && request.resource.data.participantIds.size() <= 2
        && (request.resource.data.participantIds.size() == 1
          || request.resource.data.participantIds[0] != request.resource.data.participantIds[1])
        && request.auth.uid in request.resource.data.participantIds;
    }

    function validAuthorSnapshot() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return anonymousUser()
        ? request.resource.data.authorIsGuest == true
          && request.resource.data.authorName == 'Guest'
        : request.resource.data.authorIsGuest == false
          && request.resource.data.authorName == profile.data.displayName
          && request.resource.data.authorAvatarId == profile.data.avatarId;
    }

    function validMessage() {
      return request.resource.data.keys().hasOnly([
          'authorId', 'authorName', 'authorAvatarId', 'authorIsGuest',
          'text', 'deleted', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorAvatarId is string
        && request.resource.data.authorIsGuest is bool
        && request.resource.data.text is string
        && request.resource.data.deleted is bool
        && (request.resource.data.text.size() > 0 || request.resource.data.deleted == true);
    }

    function messageOwner() {
      return signedIn() && resource.data.authorId == request.auth.uid;
    }

    function immutableMessageFields() {
      return request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.authorAvatarId == resource.data.authorAvatarId
        && request.resource.data.authorIsGuest == resource.data.authorIsGuest
        && request.resource.data.createdAt == resource.data.createdAt
        && (resource.data.deleted == false || request.resource.data.deleted == true);
    }

    function validReaction(reactionId) {
      return request.resource.data.keys().hasOnly(['emoji', 'userId', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.emoji is string
        && reactionId == request.auth.uid + '__' + request.resource.data.emoji;
    }

    function reactionOwner() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /channelNames/{nameKey} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && validChannelName(nameKey);
      allow update: if false;
      allow delete: if signedIn()
        && (registeredChannelMemberAfter(resource.data.channelId)
          || guestChannelEditor(getAfter(
            /databases/$(database)/documents/channels/$(resource.data.channelId)
          ).data));
    }

    match /channels/{channelId} {
      allow read: if channelAccessData(resource.data);
      allow create: if signedIn()
        && validChannel()
        && request.auth.uid == request.resource.data.creatorId
        && (!request.resource.data.keys().hasAny(['creatorIsGuest'])
          || request.resource.data.creatorIsGuest == anonymousUser())
        && channelAccessData(request.resource.data);
      allow update: if (registeredChannelMember(channelId)
          || (guestChannelEditor(resource.data)
            && request.resource.data.memberIds == resource.data.memberIds
            && request.resource.data.guestAccess == resource.data.guestAccess))
        && validChannel()
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('creatorIsGuest', false)
          == resource.data.get('creatorIsGuest', false)
        && request.resource.data.get('autoJoin', false)
          == resource.data.get('autoJoin', false);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if channelAccess(channelId);
        allow create: if channelAccess(channelId)
          && validMessage()
          && validAuthorSnapshot();
        allow update: if channelAccess(channelId)
          && messageOwner()
          && validMessage()
          && immutableMessageFields();
        allow delete: if false;

        match /reactions/{reactionId} {
          allow read: if channelAccess(channelId);
          allow create: if channelAccess(channelId) && validReaction(reactionId);
          allow update: if false;
          allow delete: if channelAccess(channelId) && reactionOwner();
        }

        match /replies/{replyId} {
          allow read: if channelAccess(channelId);
          allow create: if channelAccess(channelId)
            && validMessage()
            && validAuthorSnapshot();
          allow update: if channelAccess(channelId)
            && messageOwner()
            && validMessage()
            && immutableMessageFields();
          allow delete: if false;

          match /reactions/{reactionId} {
            allow read: if channelAccess(channelId);
            allow create: if channelAccess(channelId) && validReaction(reactionId);
            allow update: if false;
            allow delete: if channelAccess(channelId) && reactionOwner();
          }
        }
      }
    }

    match /directMessages/{dmId} {
      allow get: if signedIn()
        && ((resource == null && selfDirectMessage(dmId))
          || (resource != null && request.auth.uid in resource.data.participantIds));
      allow list: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && validDirectMessage()
        && (request.resource.data.participantIds.size() == 2
          || selfDirectMessage(dmId));
      allow update: if directMessageAccess(dmId)
        && validDirectMessage()
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if directMessageAccess(dmId);
        allow create: if directMessageAccess(dmId)
          && validMessage()
          && validAuthorSnapshot();
        allow update: if directMessageAccess(dmId)
          && messageOwner()
          && validMessage()
          && immutableMessageFields();
        allow delete: if false;

        match /reactions/{reactionId} {
          allow read: if directMessageAccess(dmId);
          allow create: if directMessageAccess(dmId) && validReaction(reactionId);
          allow update: if false;
          allow delete: if directMessageAccess(dmId) && reactionOwner();
        }

        match /replies/{replyId} {
          allow read: if directMessageAccess(dmId);
          allow create: if directMessageAccess(dmId)
            && validMessage()
            && validAuthorSnapshot();
          allow update: if directMessageAccess(dmId)
            && messageOwner()
            && validMessage()
            && immutableMessageFields();
          allow delete: if false;

          match /reactions/{reactionId} {
            allow read: if directMessageAccess(dmId);
            allow create: if directMessageAccess(dmId) && validReaction(reactionId);
            allow update: if false;
            allow delete: if directMessageAccess(dmId) && reactionOwner();
          }
        }
      }
    }
  }
}
