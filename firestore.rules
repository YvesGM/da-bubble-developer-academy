rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function anonymousUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function channelAccessData(data) {
      return signedIn()
        && (request.auth.uid in data.memberIds
          || (anonymousUser() && data.guestAccess == true));
    }

    function channelAccess(channelId) {
      return channelAccessData(
        get(/databases/$(database)/documents/channels/$(channelId)).data
      );
    }

    function registeredChannelMember(channelId) {
      return signedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/channels/$(channelId)
        ).data.memberIds;
    }

    function registeredChannelMemberAfter(channelId) {
      return signedIn()
        && request.auth.uid in getAfter(
          /databases/$(database)/documents/channels/$(channelId)
        ).data.memberIds;
    }

    function validChannel() {
      return request.resource.data.keys().hasOnly([
          'name', 'normalizedName', 'nameKey', 'description', 'creatorId',
          'memberIds', 'guestAccess', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.normalizedName is string
        && request.resource.data.nameKey is string
        && request.resource.data.description is string
        && request.resource.data.creatorId is string
        && request.resource.data.memberIds is list
        && request.resource.data.guestAccess is bool;
    }

    function validChannelName(nameKey) {
      let channelId = request.resource.data.channelId;
      let channel = getAfter(/databases/$(database)/documents/channels/$(channelId));
      return request.resource.data.keys().hasOnly(['channelId', 'normalizedName'])
        && channelId is string
        && request.resource.data.normalizedName is string
        && channel.data.nameKey == nameKey
        && channel.data.normalizedName == request.resource.data.normalizedName
        && channelAccessData(channel.data);
    }

    function directMessageAccess(dmId) {
      return signedIn()
        && !anonymousUser()
        && request.auth.uid in get(
          /databases/$(database)/documents/directMessages/$(dmId)
        ).data.participantIds;
    }

    function validDirectMessage() {
      return request.resource.data.keys().hasOnly([
          'participantIds', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds;
    }

    function validMessage() {
      return request.resource.data.keys().hasOnly([
          'authorId', 'authorName', 'authorAvatarId', 'authorIsGuest',
          'text', 'deleted', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorAvatarId is string
        && request.resource.data.authorIsGuest is bool
        && request.resource.data.text is string
        && request.resource.data.deleted is bool
        && (request.resource.data.text.size() > 0 || request.resource.data.deleted == true);
    }

    function messageOwner() {
      return signedIn() && resource.data.authorId == request.auth.uid;
    }

    function immutableMessageFields() {
      return request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.authorAvatarId == resource.data.authorAvatarId
        && request.resource.data.authorIsGuest == resource.data.authorIsGuest
        && request.resource.data.createdAt == resource.data.createdAt
        && (resource.data.deleted == false || request.resource.data.deleted == true);
    }

    function validReaction() {
      return request.resource.data.keys().hasOnly(['emoji', 'userId', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.emoji is string;
    }

    function reactionOwner() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /channelNames/{nameKey} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && validChannelName(nameKey);
      allow update: if false;
      allow delete: if signedIn()
        && registeredChannelMemberAfter(resource.data.channelId);
    }

    match /channels/{channelId} {
      allow read: if channelAccessData(resource.data);
      allow create: if signedIn()
        && validChannel()
        && request.auth.uid == request.resource.data.creatorId
        && channelAccessData(request.resource.data);
      allow update: if registeredChannelMember(channelId)
        && validChannel()
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if channelAccess(channelId);
        allow create: if channelAccess(channelId) && validMessage();
        allow update: if channelAccess(channelId)
          && messageOwner()
          && validMessage()
          && immutableMessageFields();
        allow delete: if false;

        match /reactions/{reactionId} {
          allow read: if channelAccess(channelId);
          allow create: if channelAccess(channelId) && validReaction();
          allow update: if false;
          allow delete: if channelAccess(channelId) && reactionOwner();
        }

        match /replies/{replyId} {
          allow read: if channelAccess(channelId);
          allow create: if channelAccess(channelId) && validMessage();
          allow update: if channelAccess(channelId)
            && messageOwner()
            && validMessage()
            && immutableMessageFields();
          allow delete: if false;

          match /reactions/{reactionId} {
            allow read: if channelAccess(channelId);
            allow create: if channelAccess(channelId) && validReaction();
            allow update: if false;
            allow delete: if channelAccess(channelId) && reactionOwner();
          }
        }
      }
    }

    match /directMessages/{dmId} {
      allow read: if signedIn()
        && !anonymousUser()
        && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && !anonymousUser()
        && validDirectMessage();
      allow update: if directMessageAccess(dmId)
        && validDirectMessage()
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if directMessageAccess(dmId);
        allow create: if directMessageAccess(dmId) && validMessage();
        allow update: if directMessageAccess(dmId)
          && messageOwner()
          && validMessage()
          && immutableMessageFields();
        allow delete: if false;

        match /reactions/{reactionId} {
          allow read: if directMessageAccess(dmId);
          allow create: if directMessageAccess(dmId) && validReaction();
          allow update: if false;
          allow delete: if directMessageAccess(dmId) && reactionOwner();
        }

        match /replies/{replyId} {
          allow read: if directMessageAccess(dmId);
          allow create: if directMessageAccess(dmId) && validMessage();
          allow update: if directMessageAccess(dmId)
            && messageOwner()
            && validMessage()
            && immutableMessageFields();
          allow delete: if false;

          match /reactions/{reactionId} {
            allow read: if directMessageAccess(dmId);
            allow create: if directMessageAccess(dmId) && validReaction();
            allow update: if false;
            allow delete: if directMessageAccess(dmId) && reactionOwner();
          }
        }
      }
    }
  }
}
